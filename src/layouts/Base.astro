---
import Metatags from '../components/page/Metatags'
import '../styles/index.scss'
import { gaMeasurementId } from '../config'

// page-level overrides, falling back to site config (inside Metatags)
interface Props {
  title?: string
  description?: string
  metaImageUrl?: string
  path?: string
}

const {
  title,
  description,
  metaImageUrl,
  path = Astro.url.pathname,
} = Astro.props

// track only production builds
const useAnalytics = import.meta.env.PROD
---

<!doctype html>
<html lang="en">
  <head>
    {/* basics: encoding + mobile rendering */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* SEO + social cards: title, description, canonical, og:*, favicon */}
    <Metatags
      path={path}
      title={title}
      description={description}
      metaImageUrl={metaImageUrl}
    />
    {/* Webfonts: Open Sans (body) + JetBrains Mono (code blocks) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&family=Open+Sans:ital,wght@0,300;0,500;0,700;1,300;1,500&display=swap"
      rel="stylesheet"
    />
    {/* Google Analytics */}
    {/* define:vars exposes the id to the script — is:inline scripts don't see frontmatter vars */}
    {useAnalytics && (
      <>
        <script
          id="google-analytics-setup"
          src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          async
          is:inline
        ></script>
        <script id="google-analytics" define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || []
          function gtag() {
            dataLayer.push(arguments)
          }
          gtag('js', new Date())
          gtag('config', gaMeasurementId)
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
