---
import Base from '../layouts/Base.astro'
import Page from '../layouts/Page.astro'
import Container from '../components/page/Container'
import Spacer from '../components/Spacer'
import ProjectsCategories from '../components/projects-grid/ProjectsCategories'
import { getProjectPreviews } from '../models/Project'

const projects = await getProjectPreviews()
---

<Base>
  <Page>
    <Container>
      <Spacer amount="lg" />
      <ProjectsCategories projects={projects} client:load />
      <Spacer amount="xl" />
    </Container>
  </Page>
</Base>
